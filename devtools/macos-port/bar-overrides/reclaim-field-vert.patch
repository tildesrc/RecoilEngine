+// GL 4.1 override: SSBOs are GL 4.3, so the per-chunk parameters travel as a
+// buffer texture (core since 3.1) and are read with texelFetch. Two texels per
+// chunk, exactly the two vec4 the SSBO held.
+// See devtools/macos-port/SSBO-FALLBACK.md.
+// NB: the unit must be a literal here. The engine lifts layout(binding) out of
+// the source textually, before the preprocessor runs, so a shaderConfig define
+// would still be an unresolved identifier at that point. Keep this in step with
+// CLUSTER_PARAMS_UNIT in reclaim_field_renderer_gl4.lua.
+layout(binding = 11) uniform samplerBuffer clusterParams;
 
+#define params(i) texelFetch(clusterParams, (i))
+
 //__ENGINEUNIFORMBUFFERDEFS__
 
