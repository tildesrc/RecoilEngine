+// GL 4.1 override: SSBOs are 4.3, so the engine publishes the transform array
+// as a GL_TEXTURE_BUFFER on a reserved unit instead. Transform is 32 bytes,
+// exactly two RGBA32F texels: quat then trSc.
+// See devtools/macos-port/SSBO-FALLBACK.md.
+layout(binding = 13) uniform samplerBuffer modelTransforms;
+
+Transform fetchTransform(uint idx) {
+	int b = int(idx) * 2;
+	return Transform(
+		texelFetch(modelTransforms, b + 0),
+		texelFetch(modelTransforms, b + 1)
+	);
+}
 
